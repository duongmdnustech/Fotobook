<div class="container w-100 align-items-start border-bottom pb-3 rounded shadow">
  <div class="profile-header d-flex align-items-center ps-2">
    
    <div class="profile-avatar-container me-4">
      <% if user.avatar.present? %>
        <%= image_tag user.avatar.url ? user.avatar.url : user.avatar, alt: "User Avatar", class: "rounded-circle img-fluid border", style: "width: 150px; height: 150px; object-fit: cover;" %>
      <% else %>
        <div class="rounded-circle bg-primary text-white text-center fw-bold" style="width: 150px; height: 150px; line-height: 150px; aspect-ratio: 1 / 1; font-size: 70px">
          <%= user.lname[0].capitalize + user.fname[0].capitalize %>
        </div>
      <% end %>
    </div>

    <div class="profile-info">
      <% if user == current_user %>
        <%= link_to "Edit Profile", edit_profile_path, class: "btn btn-outline-primary btn-sm rounded-pill px-3 py-0 mb-2", style: "font-size: 0.8rem; height: fit-content;", data: { turbo_prefetch: false } %>
      <% else %>
        <div class="flex-shrink-0 mb-2" data-controller="follow">
          <% if current_user.active_followings.pluck(:following_id).include?(user.id) %>
            <button type="button" class="btn btn-gradient btn-ms" id="unfollow-[<%= user.id %>]" style="font-weight: bold; font-size: 0.9rem;" data-action="follow#unfollow">Following</button>
          <% else %>
            <button type="button" class="btn btn-gradient-outline btn-ms" id="follow-[<%= user.id %>]" style="font-weight: bold; font-size: 0.9rem;" data-action="follow#follow">Follow</button>
          <% end %>
        </div>
      <% end %>
      <div class="d-flex align-items-center mb-2">
        <h2 class="fw-bold mb-0 me-3 text-dark"><%= user.fname + " " + user.lname %></h2>
      </div>

      <div class="d-flex text-uppercase text-muted" style="font-size: 0.9rem; letter-spacing: 0.5px;">
        
        <%# --- 1. PHOTOS TAB --- %>
        <%# Kiểm tra active %>
        <% active_photos = request.path.include?('photos') %>
        
        <%= link_to (user == current_user) ? photos_profile_path : user_photos_path(user), class: "me-4 text-decoration-none", style: "cursor: pointer;", data: { turbo_prefetch: false } do %>
          <span class="fw-bold fs-5 <%= active_photos ? 'text-primary' : 'text-dark' %>">
            <%= (user == current_user) ? user.photos.size : user.public_photos.size %>
          </span> 
          <span class="small <%= active_photos ? 'text-primary fw-bold' : 'text-muted' %>">Photos</span>
        <% end %>

        <%# --- 2. ALBUMS TAB --- %>
        <% active_albums = request.path.include?('albums') %>

        <%= link_to (user == current_user) ? albums_profile_path : user_albums_path(user), class: "mx-4 border-start ps-4 text-decoration-none", style: "cursor: pointer;", data: { turbo_prefetch: false } do %>
          <span class="fw-bold fs-5 <%= active_albums ? 'text-primary' : 'text-dark' %>">
            <%= (user == current_user) ? user.albums.size : user.public_albums.size %>
          </span> 
          <span class="small <%= active_albums ? 'text-primary fw-bold' : 'text-muted' %>">Albums</span>
        <% end %>

        <%# --- 3. FOLLOWINGS TAB --- %>
        <% active_followings = request.path.include?('followings') %>

        <%= link_to (user == current_user) ? followings_profile_path : user_followings_path(user), class: "mx-4 border-start ps-4 text-decoration-none", style: "cursor: pointer;", data: { turbo_prefetch: false } do %>
          <span class="fw-bold fs-5 <%= active_followings ? 'text-primary' : 'text-dark' %>">
            <%= user.active_followings.size %>
          </span> 
          <span class="small <%= active_followings ? 'text-primary fw-bold' : 'text-muted' %>">Followings</span>
        <% end %>

        <%# --- 4. FOLLOWERS TAB --- %>
        <% active_followers = request.path.include?('followers') %>

        <%= link_to (user == current_user) ? followers_profile_path : user_followers_path(user), class: "ms-4 border-start ps-4 text-decoration-none", style: "cursor: pointer;", data: { turbo_prefetch: false } do %>
          <span class="fw-bold fs-5 <%= active_followers ? 'text-primary' : 'text-dark' %>">
            <%= user.passive_followers.size %>
          </span> 
          <span class="small <%= active_followers ? 'text-primary fw-bold' : 'text-muted' %>">Followers</span>
        <% end %>

      </div>
    </div>
  </div>
</div>

