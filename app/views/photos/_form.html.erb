<%= form_with(model: photo, class: "row g-4") do |form| %> <%# --- CỘT BÊN TRÁI --- %>
  <div class="col-12 col-md-6 d-flex flex-column gap-3">
    <div>
      <%= form.label :title, class: "form-label fw-bold" %>
      <%= form.text_field :title, class: "form-control", placeholder: "Photo Title" %>
    </div>

    <div class="w-50"> 
      <%= form.label :status, "Sharing mode", class: "form-label fw-bold" %>
      <%= form.select :status, options_for_select([["Public", true], ["Private", false]], photo&.status), {}, { class: "form-select" } %>
    </div>

    <div class="mb-3 col-12 col-md-6" data-controller="form" >
      <%= form.label :image, class: "form-label fw-bold" %>

      <%# Kiểm tra xem ảnh đã có trong DB chưa %>
      <% has_image = photo.url? %> 
      <%# Nếu dùng CarrierWave thì đổi thành: photo.image.present? %>

      <%# Logic class: Nếu có ảnh thì bỏ viền nét đứt (border-0) và bỏ màu nền (bg-transparent) %>
      <%= form.label :image, class: "image-upload-box position-relative #{'border-0 bg-transparent' if has_image}", style: "#{ 'height: auto; min-height: auto;' if has_image }" do %>
        
        <div class="text-center text-muted <%= 'd-none' if has_image %>" data-form-target="placeholder" >
          <span style="font-size: 3rem; line-height: 1;">+</span>
          <div class="small mt-1">Click to upload</div>
        </div>

        <%= image_tag (has_image ? photo.url : ""), 
          class: "preview-result w-100 rounded shadow-sm #{'d-none' unless has_image}", 
          style: "object-fit: contain; height: auto;", 
          data: { 
            form_target: "image",
            original_url: (photo.url if has_image) # Lưu URL gốc vào đây
          } %>

        <%= form.file_field :image, class: "d-none", accept: "image/*", 
          data: { form_target: "input", action: "change->form#preview" } %> 
      <% end %>
    </div>

    <div class="mt-2">
      <%= form.submit "Save", class: "btn btn-success px-4" %> 
      <% if params[:action] == "edit" %>
        <%= link_to "Delete", photo_path(photo), 
          data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this photo?" }, 
          class: "btn btn-outline-danger px-4 ms-4" 
        %>
      <% end %>
    </div>
  </div>

  <%# --- CỘT BÊN PHẢI --- %>
  <div class="col-12 col-md-6">
    <div class="h-100">
      <%= form.label :description, class: "form-label fw-bold" %>
      <%= form.text_area :description, class: "form-control", placeholder: "Photo Description", style: "height: 150px; resize: none;" %> 
    </div>
  </div>

<% end %>