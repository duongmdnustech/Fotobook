<div class="container-fluid ms-4">
  <%= turbo_frame_tag "photos_list" do %>
    <div id="photos" class="row g-4 justify-content-start mb-5">
      <% @albums.each do |album| %>
        <div class="col-12 col-md-4 col-lg-3">
          
          <div class="card custom-card h-100 position-relative border shadow bg-light">
            
            <div class="card-overlay-header">
              <p class="text-truncate mb-0 fw-bold text-shadow"> <%= album.title %>
              </p>

              <%= link_to "", edit_album_path(album), 
                  class: "text-decoration-none text-white bi bi-pencil-square ms-2 position-relative z-2", 
                  style: "cursor: pointer;",
                  data: { turbo_frame: "_top", turbo_prefetch: false } 
              %>
            </div>
            
            <%# Sử dụng image_tag nếu bạn dùng ActiveStorage hoặc link trực tiếp %>
            <% f_photo = album.photos.first %>
            
            <div class="card-body d-flex align-items-center justify-content-center pt-5 pb-4">
              <div class="photo-stack mx-auto">
                <img src="<%= f_photo ? f_photo.url : "https://tse3.mm.bing.net/th/id/OIP.iWIEidVomFA1iDjwsqxv6wHaHa?rs=1&pid=ImgDetMain&o=7&rm=3" %>" class="card-img-custom shadow" alt="<%= album.title %>">
              </div>
            </div>

          </div>
        </div>
      <% end %>
    </div>

    <div class="d-flex justify-content-center mt-4 fw-bold">
      <%== @pagy.series_nav(:bootstrap) %>
    </div>
  <% end %>
</div>