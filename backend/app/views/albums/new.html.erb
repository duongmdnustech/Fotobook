<% content_for :head do %>
  <%= stylesheet_link_tag "definition", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "view", "data-turbo-track": "reload" %>
<% end %>
<%= render "users/shared/header", page: "new_photo" %>

<main>
  <div class="container-fluid post-view mt-100">
    <%= render "home/side_bar", page: "new_photo" %>
    <div class="w-100 rounded shadow p-4 me-3">
      <h2 class="fw-bold border-bottom pb-3 mb-3">New Album</h2>
      <%= render "form", album: @album %>
    </div>
  </div>
</main>