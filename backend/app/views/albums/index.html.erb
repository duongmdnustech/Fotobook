<div class="row w-100" id="albums-list"> 
  <% @albums.each do |album| %>
    <div class="col-12 col-lg-6 col-xl-4 justify-content-center mb-4 d-flex align-items-stretch"> 
      <%= render album %>
    </div>
  <% end %>
</div>

<div id="pagination">
  <% if @pagy.next %>
    <%= turbo_frame_tag "albums_page_#{@pagy.next}", 
                        src: albums_path(
                          page: @pagy.next, 
                          type: params[:type],
                          query: params[:query],
                          format: :turbo_stream
                        ), 
                        loading: :lazy do %>
      <div class="spinner-border text-primary" role="status"></div>
    <% end %>
  <% end %>
</div>