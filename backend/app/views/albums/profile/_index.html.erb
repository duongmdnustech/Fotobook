<% content_for :head do %>
  <%= stylesheet_link_tag "album", "data-turbo-track": "reload" %>
<% end %>
<div class="container mt-3 p-3 rounded shadow w-100">
  <% if page == "profile" %>
    <div class="d-flex justify-content-end mb-5">
      <a href="/albums/new" class="btn btn-success">+ Add Album</a>
    </div>
  <% end %>

  <div class="row g-4"> 
    <% user.albums.each do |album| %>
      <% next if user != current_user && !album.status %>
      
      <div class="col-6 col-md-4 col-lg-3">
        <%= render "albums/profile/album", album: album %>
      </div>
    <% end %>
  </div>
</div>