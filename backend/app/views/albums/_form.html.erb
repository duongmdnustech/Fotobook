<%= form_with(model: album, class: "row g-4") do |form| %> 
  <%# --- CỘT BÊN TRÁI --- %>
  <div class="col-12 col-md-6 d-flex flex-column gap-3">
    <div>
      <%= form.label :title, class: "form-label fw-bold" %>
      <%= form.text_field :title, class: "form-control", placeholder: "Album Title" %>
    </div>

    <div class="w-50"> 
      <%= form.label :status, "Sharing mode", class: "form-label fw-bold" %>
      <%= form.select :status, options_for_select([["Public", true], ["Private", false]], album&.status), {}, { class: "form-select" } %>
    </div>
  </div>

  <%# --- CỘT BÊN PHẢI --- %>
  <div class="col-12 col-md-6">
    <div class="h-100">
      <%= form.label :description, class: "form-label fw-bold" %>
      <%= form.text_area :description, class: "form-control", placeholder: "Album Description", style: "height: 150px; resize: none;" %> 
    </div>
  </div>

  <%# --- PHẦN 1: ADD EXISTING PHOTOS --- %>
  <div class="mb-4">
    <h5 class="fw-bold mb-4">Select from Library</h5>
    <div class="row">
      <% user_photos = current_user.photos %> 
      <%= form.collection_check_boxes :photo_ids, user_photos, :id, :url do |b| %>
        <div class="col-6 col-md-3 mb-3">
          <div class="card h-100 shadow-sm">
            <%= image_tag b.object.url, class: "card-img-top object-fit-cover", height: "150" %>
            <div class="card-body text-center">
              <div class="form-check d-inline-block">
                <%= b.check_box class: "form-check-input" %>
                <%= b.label class: "form-check-label" do %>Add to Album<% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <hr>

  <%# --- PHẦN 2: UPLOAD NEW PHOTO --- %>
  <div class="mb-4" data-controller="upload-album-photo">
    <h5 class="fw-bold mb-4 d-flex align-items-center">
      Upload New Photo
      <svg data-action="click->upload-album-photo#add" width="35px" height="35px" style="margin-left: 15px; cursor: pointer;" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g stroke-width="0"></g><g stroke-linecap="round" stroke-linejoin="round"></g><g> <circle opacity="0.5" cx="12" cy="12" r="10" stroke="#1C274C" stroke-width="1.5"></circle> <path d="M15 12L12 12M12 12L9 12M12 12L12 9M12 12L12 15" stroke="#1C274C" stroke-width="1.5" stroke-linecap="round"></path> </g>
      </svg>
    </h5>

    <div id="photo-add-list" data-upload-album-photo-target="list" class="row w-100">
      <%= form.fields_for :photos do |photo_form| %>
        <%= render "albums/new_photo", photo_form: photo_form, album: album, form: form %>
      <% end %>
    </div>

    <template data-upload-album-photo-target="template">
      <%= form.fields_for :photos, Photo.new, child_index: "NEW_RECORD" do |photo_form| %>
        <%= render "albums/new_photo", photo_form: photo_form, album: album, form: form %>
      <% end %>
    </template>

  <%# --- BUTTONS --- %>
  <div class="mt-4">
    <%= form.submit "Save", class: "btn btn-success px-4" %> 
    
    <%# SỬA LỖI TẠI ĐÂY: Dùng album.persisted? thay vì params[:action] và dùng album_path %>
    <% if album.persisted? %>
      <%= link_to "Delete Album", album_path(album), 
        data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this album?" }, 
        class: "btn btn-outline-danger px-4 ms-4" 
      %>
    <% end %>
  </div>
<% end %>