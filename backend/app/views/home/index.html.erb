<% content_for :head do %>
  <%= stylesheet_link_tag "definition", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "view", "data-turbo-track": "reload" %>
<% end %>
<%= render "users/shared/header", page: "home" %>
<main>
  <div class="container-fluid post-view mt-100">
    <%= render "home/side_bar" %>
    <div class="main d-flex flex-column align-items-center w-100">
      <div class="btn-group align-self-center justify-self-center" role="group" aria-label="Basic example">
        <div class="btn btn-primary fw-bold text-white btn-outline-primary" id="photo-tab">Photo</div>
        <div style="height: 100%; width: 2px; background-color: aliceblue;"></div>
        <div class="btn btn-white fw-bold text-primary btn-outline-secondary" id="album-tab">Album</div>
      </div>
      <div id="card-group" class="w-100 mt-4">
        <%= render template: "photos/index", photos: current_user.public_photos, locals: {type: "following"} %>
      </div>
    </div>
  </div>
</main>