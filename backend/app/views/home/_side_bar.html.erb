              </g>
            </svg>
          </div>
        </div>
      <% end %>
    </div>
    <div class="offcanvas-body">
      <form class="d-flex mb-2" role="search">
        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search"/>
        <button class="btn btn-outline-success" type="submit">Search</button>
      </form>
      <ul class="navbar-nav justify-content-end flex-grow-1 pe-3">
        <li class="nav-item">
          <%= link_to "Feeds", 
              photos_path(type: "following"), 
              class: "text-decoration-none page #{'disable' unless params[:type] == 'following'}", 
              id: "feed",
              data: { 
                action: "click->home#switch_page" # Giữ lại action để đổi màu ngay lập tức
              } 
          %>
        </li>
        <li class="nav-item">
          <%= link_to "Discover", 
              photos_path(type: "discover"), 
              class: "text-decoration-none page #{'disable' if params[:type] == 'following'}", 
              id: "discover",
              data: { 
                action: "click->home#switch_page" 
              } 
          %>
        </li>
      </ul>
      <%= link_to "Logout", destroy_user_session_path, data: {turbo_method: :delete}, class: "text-decoration-none btn btn-danger shadow p-2 mb-3 ms-3 rounded logout position-absolute bottom-0 start-0" %>
    </div>
  </div>
</div>
<% else %>
<div data-controller="home" class="me-5 w-100">
  <div class="d-none d-md-flex flex-column p-3 sticky-top w-100 z-1" style="top: 20px;">
    <div class="nav flex-row nav-pills gap-5 justify-self-center align-self-center" aria-orientation="vertical">
      
      <%= link_to admin_photos_path, 
          class: "nav-link mb-2 text-start #{'active' if request.path.include?('photos')}",
          id: "photo" do %>
        <i class="bi bi-images me-2"></i> Manage Photos
      <% end %>

      <%= link_to admin_albums_path, 
          class: "nav-link mb-2 text-start #{'active' if request.path.include?('albums')}",
          id: "album" do %>
        <i class="bi bi-journal-album me-2"></i> Manage Albums
      <% end %>

      <%= link_to admin_users_path, 
          class: "nav-link mb-2 text-start #{'active' if request.path.include?('users')}",
          id: "user" do %>
        <i class="bi bi-people me-2"></i> Manage Users
      <% end %>
      
    </div>
  </div>

