<div class="d-inline-block mb-4" style="width: 250px;"> 
  <div class="position-relative border rounded" data-bs-toggle="modal" data-bs-target="#photoModal-<%= photo.photo_id %>" style="cursor: pointer;">
    <img src=<%= photo.url %> 
         class="img-fluid rounded shadow-sm w-100" 
         alt="Photo"
         style="object-fit: cover; aspect-ratio: 1/1;"
    > 

    <% if !photo.status %>
      <div class="position-absolute top-0 end-0 m-2">
        <div class="bg-black text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; opacity: 0.8;">
          <i class="bi bi-lock-fill" style="font-size: 0.9rem;"></i>
        </div>
      </div>
    <% end %>
    <% if current_user == photo.user %>
    <a href="/photos/<%= photo.id %>/edit" class="position-absolute bottom-0 end-0 m-2 me-3 text-white text-decoration-none fw-bold small rounded bg-dark p-1" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.8); letter-spacing: 0.5px; opacity: 0.8;">
      EDIT
    </a>
    <% end %>
  </div>

  <div class="mt-2 text-center text-muted small fw-semibold">
    <%= photo.title %>
  </div>
</div>

<% if photo.user != current_user %>
<div class="modal fade" id="photoModal-<%= photo.photo_id %>" tabindex="-1" aria-labelledby="photoModalLabel-<%= photo.photo_id %>" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="photoModalLabel-<%= photo.photo_id %>"><%= photo.title %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <img src="<%= photo.url %>" class="img-fluid rounded w-100 mb-3 shadow border" alt="<%= photo.title %>">
        
        <p class="text-muted mb-0">
          <%= photo.description %>
        </p>
      </div>
    </div>
  </div>
</div>
<% end %>