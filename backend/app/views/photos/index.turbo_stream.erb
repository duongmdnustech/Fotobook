<%# 1. Nối thêm các card ảnh mới vào container %>
<%= turbo_stream.append "photos-list" do %>
  <% if @photos && @photos.any? %>
    <% @photos.each do |photo| %>
      <div class="col-12 col-lg-6 col-xl-4 justify-content-center mb-4 d-flex align-items-stretch"> 
        <%= render photo %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%# 2. Thay thế cái pagination cũ bằng cái mới (hoặc xóa sạch nếu hết trang) %>
<%= turbo_stream.replace "pagination" do %>
  <div id="pagination">
    <% if @pagy.next %>
      <%= turbo_frame_tag "photos_page_#{@pagy.next}", 
                          src: photos_path(page: @pagy.next, type: params[:type], query: params[:query], format: :turbo_stream), 
                          loading: :lazy do %>
        <div class="text-center p-4">
           <div class="spinner-border text-primary" role="status"></div>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>