<% if avatar.present? && avatar.url %>
  <%= image_tag avatar.url, alt: "User Avatar", class: "rounded-circle", width: "40", height: "40" %>
<% else %>
  <div class="rounded-circle bg-primary text-white text-center fw-bold border" style="width: 40px; height: 40px; line-height: 40px; aspect-ratio: 1 / 1;">
    <%= user&.lname[0].capitalize + user&.fname[0].capitalize %>
  </div>
<% end %>