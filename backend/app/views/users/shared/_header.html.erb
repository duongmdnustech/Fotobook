<% content_for :head do %>
  <%= stylesheet_link_tag "definition", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "navbar", "data-turbo-track": "reload" %>
<% end %>

<nav class="navbar bg-primary z-2" data-bs-theme="dark">
  <div class="container-fluid d-flex">
    <%# Title %>
    <div class="title">
      <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <%= image_tag "logo.png" %>
      Fotobook
    </div>

    <%# Search bar %>
    <% if user_signed_in? %>
      <form class="d-none d-md-flex" style="min-width: 350px;" role="search">
        <div class="input-group w-100">
          <div data-controller="home" class="w-100">
            <input 
              type="search" 
              class="form-control w-100" 
              placeholder="Search Photo / Album" 
              data-home-target="searchInput"
              aria-label="Search"
              data-action="input->home#onSearchChange"
              value="<%= params[:query] %>"
            >
          </div>
        </div>
      </form>
    <% end %>

    <%# Navigation Controll %>
    <% if page == 'signup' %>
      <%= link_to "/auth/login", class: "item" do %>
        Login
      <% end %>
    <% elsif page == 'login' %>
      <%= link_to "/auth/register", class: "item" do %>
        Sign up
      <% end %>
    <% else %>
      <div class="item">
        <div class="d-none d-lg-flex gap-2 align-items-center home">
          <%= link_to "/profile", class: "text-decoration-none text-white" do %>
            <div class="profile d-flex gap-2 align-items-center text-decoration-none">
              <%= render "users/shared/avatar", avatar: current_user.avatar %>
              <div class="text-decoration-none"><%= current_user.fname + " " + current_user.lname %></div>
            </div>
          <% end %>
          <%= link_to "Logout", destroy_user_session_path, data: {turbo_method: :delete}, class: "text-decoration-none logout" %>
        </div>
        <div class="d-flex d-lg-none">
          <div class="profile d-flex gap-2 align-items-center text-decoration-none">
            <%= render "users/shared/avatar", avatar: current_user.avatar %>
          </div>
        </div>
      </div>
    <% end %>
  </div> 
</nav>