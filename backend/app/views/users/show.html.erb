<p style="color: green"><%= notice %></p>
<% content_for :head do %>
  <%= stylesheet_link_tag "definition", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "view", "data-turbo-track": "reload" %>
<% end %>
<%= render "users/shared/header", user: @user, page: "profile" %>

<main>
  <%= render "home/side_bar", page: "profile" %>
  <%= render "users/shared/profile", user: @user ? @user : current_user, page: @user ? "user" : "profile" %>
</main>
